{
  "name": "mcp-catalog-snapshot",
  "version": "1.0.0",
  "description": "Collect complete MCP catalogs with hard pagination bounds and atomic last-known-good snapshots.",
  "keywords": ["mcp", "model-context-protocol", "pagination", "catalog", "ai-agents", "snapshot"],
  "license": "MIT",
  "author": "Huzaifa Asif",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huzaifa-Asif/mcp-catalog-snapshot.git"
  },
  "bugs": { "url": "https://github.com/Huzaifa-Asif/mcp-catalog-snapshot/issues" },
  "homepage": "https://github.com/Huzaifa-Asif/mcp-catalog-snapshot#readme",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "files": ["src", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": { "node": ">=18" },
  "sideEffects": false,
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "check": "npm run lint && npm run test:coverage && npm pack --dry-run"
  },
  "publishConfig": { "access": "public" }
}
